# Copy to .env at repository root. Demo credentials are PUBLIC and ONLY for synthetic local data.
PROVIDER=demo
STORE=memory
AUTH_MODE=demo
AUTH_TOKENS={"demo-analyst":["query-l1"],"demo-ops":["query-l2"],"demo-manager":["knowledge-manager"]}
# For Keycloak use compose.oidc.yaml. For a corporate provider configure these explicitly:
OIDC_ISSUER=http://localhost:8180/realms/workbench
OIDC_JWKS_URL=http://localhost:8180/realms/workbench/protocol/openid-connect/certs
OIDC_AUDIENCE=workbench-api
OIDC_CLIENT_ID=workbench-web
OIDC_SCOPE=openid profile email
OIDC_ROLES_CLAIM=realm_access.roles
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
API_BASE_URL=https://example.invalid/v1
API_KEY=
DATABASE_URL=postgresql://workbench:workbench@db:5432/workbench
REQUEST_TIMEOUT=60
TOP_K=4
OLLAMA_NUM_CTX=4096
MAX_OUTPUT_TOKENS=512
